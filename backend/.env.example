# Copia este archivo como `.env` y completa los valores.
# El `.env` NUNCA se sube a git (está en .gitignore): tiene secretos.

# --- Obligatorio ----------------------------------------------------------
# Firma las sesiones. Mínimo 32 caracteres al azar. Para generarlo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GREMIO_JWT_SECRET=

# --- Discord --------------------------------------------------------------
# Portal de desarrolladores: https://discord.com/developers/applications
# Application > OAuth2: el Client ID y el Client Secret, y la URL de retorno (Redirects):
#   <GREMIO_API_URL>/api/auth/discord/callback
GREMIO_DISCORD_CLIENT_ID=
GREMIO_DISCORD_CLIENT_SECRET=
# Application > Bot: el token del bot, que debe estar dentro de tu servidor.
GREMIO_DISCORD_BOT_TOKEN=
# ID del servidor y de los dos roles (Discord > Ajustes > Avanzado > Modo desarrollador,
# y luego clic derecho > Copiar ID).
GREMIO_DISCORD_GUILD_ID=
GREMIO_DISCORD_ROL_ADMIN_ID=
GREMIO_DISCORD_ROL_GENERAL_ID=
# Opcional: canal donde se publican las alertas (Ajustes del canal > Integraciones > Webhooks).
GREMIO_DISCORD_WEBHOOK_ALERTAS=

# --- Direcciones ----------------------------------------------------------
# Dirección pública de esta API (con ngrok, la de tu dominio fijo).
GREMIO_API_URL=http://localhost:8000
# Dirección del frontend, adonde se vuelve después de iniciar sesión.
GREMIO_FRONTEND_URL=http://localhost:5173
# Orígenes del frontend con permiso de llamar a la API, separados por comas.
# Solo el origen, sin ruta: https://tuusuario.github.io
GREMIO_CORS_ORIGENES=http://localhost:5173

# --- Opcionales (estos son los valores por defecto) -----------------------
GREMIO_DB=data/gremio.db
GREMIO_TOKEN_HORAS=12
GREMIO_INTERVALO_ALERTAS_MINUTOS=15
